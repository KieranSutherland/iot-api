{
    "private": true,
    "workspaces": {
        "packages": [
            "packages/*"
        ]
    },
    "scripts": {
        "build": "yarn workspaces foreach -Apt --jobs 4 run build",
        "clean": "rimraf -g './packages/*/build' && rimraf -g './packages/**/*.tsbuildinfo'",
        "test": "yarn workspaces foreach -Ap --jobs 4 run run-tests-once",
        "integration-test": "yarn workspaces foreach -A run integration-test",
        "setup": "node scripts/setup.js && yarn install && yarn run build",
        "add-package": "node scripts/addPackage.js",
        "add-dependency": "node scripts/addDependency.js",
        "g:build-ts": "cd $INIT_CWD && tsc -b",
        "g:lint": "cd $INIT_CWD && eslint --max-warnings 0",
        "g:clean": "cd $INIT_CWD && rimraf ./build && rimraf -g './**/*.tsbuildinfo'",
        "g:run-tests-once": "cd $INIT_CWD && jest --forceExit --coverage --verbose --detectOpenHandles --passWithNoTests",
        "g:integration-test": "cd $INIT_CWD && SERVICE_LOG_LEVEL=debug jest --forceExit --detectOpenHandles --config jest.itest.config.js --passWithNoTests"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.5.0",
        "@types/jest": "^29.5.1",
        "@types/node": "^24.1.0",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "chalk": "^4.1.2",
        "eslint": "^9.39.1",
        "eslint-plugin-jest": "^28.0.0",
        "eslint-plugin-jsdoc": "^61.1.12",
        "jest": "^29.7.0",
        "rimraf": "^5.0.5",
        "ts-jest": "^29.1.5",
        "typescript": "^5.5.2",
        "typescript-eslint": "^8.46.0"
    },
    "packageManager": "yarn@4.15.0",
    "resolutions": {
        "@aws-sdk/client-dynamodb": "3.515.0",
        "@aws-sdk/client-eventbridge": "3.515.0",
        "@aws-sdk/client-lambda": "3.515.0",
        "@aws-sdk/credential-provider-node": "3.515.0",
        "@aws-sdk/credential-providers": "3.515.0",
        "@aws-sdk/lib-dynamodb": "3.515.0",
        "@aws-sdk/util-dynamodb": "3.515.0"
    }
}
